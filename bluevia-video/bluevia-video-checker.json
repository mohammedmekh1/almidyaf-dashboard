        "options": {}
      }
    },
    {
      "id": "bvc-read-idea-detail-001",
      "name": "Read Idea Details",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1640, 120],
      "parameters": {
        "operation": "getAll",
        "documentId": {
          "__rl": true,
          "value": "BLUEVIA_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "ideas",
          "mode": "name"
        },
        "filters": {
          "conditions": [
            {
              "value1": "id",
              "condition": "eq",
              "value2": "={{ $json.idea_id }}"
