{
  "name": "Bluevia — BV2 KIE Checker & Blotato Publisher (every 30 min)",
  "nodes": [
    {
      "id": "bvc-trigger-001",
      "name": "Schedule — Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      }
    },
    {
      "id": "bvc-read-logs-001",
      "name": "Read Logs — Pending KIE Jobs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [440, 300],
      "parameters": {
        "operation": "getAll",
        "documentId": {
          "__rl": true,
          "value": "BLUEVIA_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "logs",
          "mode": "name"
        },
        "filters": {
          "conditions": [
            {
              "value1": "action",
              "condition": "eq",
              "value2": "pending_kie"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "bvc-if-has-pending-001",
      "name": "Has Pending Jobs?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [640, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-pending",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "bvc-noop-no-pending-001",
      "name": "No Pending Jobs — Stop",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [840, 480],
      "parameters": {}
    },
    {
      "id": "bvc-split-001",
      "name": "Split Pending Jobs",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [840, 200],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "bvc-kie-poll-001",
      "name": "KIE — Poll Job Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 200],
      "parameters": {
        "method": "GET",
        "url": "=https://api.kie.ai/api/v1/jobs/{{ $json.job_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer KIE_BEARER_TOKEN_BLUEVIA_PLACEHOLDER"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "bvc-if-completed-001",
      "name": "Is Job Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1240, 200],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-status",
              "leftValue": "={{ ($json.data?.status ?? $json.status ?? '').toLowerCase() }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "bvc-noop-not-done-001",
      "name": "Still Processing — Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1440, 380],
      "parameters": {}
    },
    {
      "id": "bvc-extract-video-001",
      "name": "Extract Video URL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1440, 120],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "field-video-url",
              "name": "video_url",
              "value": "={{ $json.data?.output?.video_url ?? $json.output?.video_url ?? $json.data?.video_url ?? $json.video_url ?? '' }}",
