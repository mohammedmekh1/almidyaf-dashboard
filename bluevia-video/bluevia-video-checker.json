    {
      "id": "bvc-build-caption-001",
      "name": "Build YouTube Caption & Hashtags",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1840, 120],
      "parameters": {
        "jsCode": "// ================================================================\n// Build final YouTube caption, description, and Blotato caption\n// ================================================================\n\nconst idea = $('Read Idea Details').first().json;\nconst extracted = $('Extract Video URL').first().json;\n\nconst destination   = String(idea.destination || '');\nconst ideaAr        = String(idea.idea_ar || extracted.topic || '');\nconst ytCaption     = String(idea.youtube_caption || '');\nconst character     = String(extracted.character || '');\nconst videoUrl      = String(extracted.video_url || '');\nconst jobId         = String(extracted.job_id || '');\nconst ideaId        = String(extracted.idea_id || '');\n\n// ---- YouTube title (max 100 chars) ----\nconst ytTitle = ytCaption\n  ? ytCaption.split('|')[0].trim().slice(0, 95)\n  : `${destination} | بلوفيا ترافل — رحلة تستحق`;\n\n// ---- YouTube description ----\nconst ytDescription = [\n  ideaAr,\n  '',\n  '━━━━━━━━━━━━━━━━━━━━━━━━━',\n  '🌍 بلوفيا ترافل | Bluevia Travel',\n  '✈️ رحلات إلى تركيا وتونس',\n  '📱 واتساب: https://wa.me/905068668849',\n  '🌐 الموقع: https://blueviatravel.com',\n  '━━━━━━━━━━━━━━━━━━━━━━━━━',\n  ytCaption ? ytCaption.split('#').slice(1).map(t => '#' + t.trim()).join(' ') : '#BlueviaTravel #SiyahaSiyaha #Turkey #Tunisia'\n].join('\\n');\n\n// ---- Social media caption (TikTok, Instagram, etc.) ----\nconst socialCaption = [\n  ideaAr,\n  '',\n  '✈️ بلوفيا ترافل | Bluevia Travel',\n  '📱 احجز عبر واتساب: wa.me/905068668849',\n  '🌐 blueviatravel.com',\n  '',\n  ytCaption.includes('#') ? ytCaption.split('#').slice(1).map(t => '#' + t.trim()).join(' ') : '#بلوفيا_ترافل #سياحة #تركيا #تونس #BlueviaTravel'\n].join('\\n');\n\nreturn [{\n  json: {\n    video_url:        videoUrl,\n    job_id:           jobId,\n    idea_id:          ideaId,\n    character,\n    destination,\n    ideaAr,\n    ytTitle,\n    ytDescription,\n    socialCaption,\n    timestamp:        new Date().toISOString()\n  }\n}];\n"
      }
    },
    {
      "id": "bvc-blotato-yt-001",
      "name": "Blotato — Publish to YouTube",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2040, 0],
      "parameters": {
        "method": "POST",
        "url": "https://api.blotato.com/v1/posts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer BLOTATO_API_KEY_PLACEHOLDER"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "body": "={{ JSON.stringify({ account_id: 111, media_url: $json.video_url, caption: $json.ytTitle, description: $json.ytDescription, post_type: 'short' }) }}",
        "options": {}
      }
