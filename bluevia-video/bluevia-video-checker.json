    {
      "id": "bvc-collect-ids-001",
      "name": "Collect Blotato Post IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2260, 360],
      "parameters": {
        "jsCode": "// Collect post IDs — nodes run sequentially: YT → TikTok → IG → FB → Twitter → Threads → here\nconst getId = (obj) => obj?.data?.id ?? obj?.id ?? obj?.post_id ?? 'unknown';\nconst getUrl = (obj) => obj?.data?.url ?? obj?.url ?? obj?.data?.youtube_url ?? '';\n\nconst ytResult      = $('Blotato — Publish to YouTube').first().json;\nconst tiktokResult  = $('Blotato — Publish to TikTok').first().json;\nconst igResult      = $('Blotato — Publish to Instagram').first().json;\nconst fbResult      = $('Blotato — Publish to Facebook').first().json;\nconst twitterResult = $('Blotato — Publish to X/Twitter').first().json;\nconst threadsResult = $('Blotato — Publish to Threads').first().json;\n\nconst ytUrl = getUrl(ytResult);\n\nconst blotato_ids = [\n  `yt:${getId(ytResult)}`,\n  `tt:${getId(tiktokResult)}`,\n  `ig:${getId(igResult)}`,\n  `fb:${getId(fbResult)}`,\n  `tw:${getId(twitterResult)}`,\n  `th:${getId(threadsResult)}`\n].join(' | ');\n\nconst captions = $('Build YouTube Caption & Hashtags').first().json;\n\nreturn [{\n  json: {\n    blotato_post_ids: blotato_ids,\n    youtube_url: ytUrl,\n    video_url: captions.video_url,\n    job_id: captions.job_id,\n    idea_id: captions.idea_id,\n    timestamp: new Date().toISOString()\n  }\n}];\n"
      }
    },
