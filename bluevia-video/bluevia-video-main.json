    {
      "id": "bv-determine-char-001",
      "name": "Determine Character & Select Idea",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [840, 300],
      "parameters": {
        "jsCode": "// ================================================================\n// Bluevia — Determine Character & Select Best Pending Idea\n// ================================================================\n\nconst configRows = $('Read Config Sheet').all().map(i => i.json);\nconst ideasRows  = $('Read Ideas Sheet').all().map(i => i.json);\n\n// ---- Parse config into a key→value map ----\nconst config = {};\nfor (const row of configRows) {\n  if (row.key) config[row.key] = row.value;\n}\n\nconst cycleCounter  = parseInt(config.cycle_counter ?? 0, 10);\nconst character     = (cycleCounter % 2 === 0) ? 'female' : 'male';\nconst characterName = (character === 'female') ? 'ليلى' : 'فارس';\nconst voiceId       = (character === 'female')\n  ? (config.elevenlabs_voice_female ?? 'EXAVITQu4vr4xnSDxMaL')\n  : (config.elevenlabs_voice_male   ?? 'onwK4e9ZLuTAKqWW03F9');\nconst imageUrl      = (character === 'female')\n  ? config.female_image_url\n  : config.male_image_url;\n\n// ---- Find best pending idea for this character ----\nconst pendingIdeas = ideasRows.filter(row => {\n  return (\n    String(row.production_status).toLowerCase() === 'pending' &&\n    String(row.character).toLowerCase() === character\n  );\n});\n\n// Sort: high priority first, then by id\nconst priorityOrder = { high: 0, medium: 1, low: 2 };\npendingIdeas.sort((a, b) => {\n  const pa = priorityOrder[String(a.priority).toLowerCase()] ?? 2;\n  const pb = priorityOrder[String(b.priority).toLowerCase()] ?? 2;\n  if (pa !== pb) return pa - pb;\n  return String(a.id).localeCompare(String(b.id));\n});\n\nconst selectedIdea = pendingIdeas[0] ?? null;\n\nif (!selectedIdea) {\n  return [{\n    json: {\n      found: false,\n      character,\n      characterName,\n      cycleCounter,\n      message: `No pending ideas for character=${character} (cycle ${cycleCounter})`\n    }\n  }];\n}\n\n// ---- Build voiceover script with CTA ----\nconst rawScript = String(selectedIdea.voiceover_script_ar || selectedIdea.idea_ar || '');\nconst ctaLine   = character === 'female'\n  ? 'تواصلي معنا اليوم عبر واتساب أو من خلال موقع blueviatravel.com'\n  : 'تواصل معنا اليوم عبر واتساب أو من خلال موقع blueviatravel.com';\n\n// Ensure script ends with CTA\nconst voiceoverScript = rawScript.includes('blueviatravel')\n  ? rawScript\n  : `${rawScript} ${ctaLine}`;\n\n// ---- Build KIE kling_prompt ----\nconst klingPrompt = String(selectedIdea.kling_prompt || '');\n\nreturn [{\n  json: {\n    found: true,\n    idea_id:          String(selectedIdea.id),\n    idea_ar:          String(selectedIdea.idea_ar || ''),\n    category:         String(selectedIdea.category || ''),\n    destination:      String(selectedIdea.destination || ''),\n    character,\n    characterName,\n    voiceId,\n    imageUrl,\n    voiceoverScript,\n    klingPrompt,\n    youtubeCaption:   String(selectedIdea.youtube_caption || ''),\n    cycleCounter,\n    nextCycleCounter: cycleCounter + 1,\n    timestamp:        new Date().toISOString()\n  }\n}];\n"
      }
    },
    {
      "id": "bv-if-idea-001",
      "name": "Has Pending Idea?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1040, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-found",
              "leftValue": "={{ $json.found }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
